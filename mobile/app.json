{
  "expo": {
    "name": "MGA",
    "slug": "mga",
    "owner": "sharlhany",
    "scheme": "mga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medguarda.MGA",
      "appleTeamId": "8976UQMWXB",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.medguarda.mga",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-background-fetch",
      [
        "expo-notifications",
        {
          "color": "#0F3D3E",
          "enableBackgroundRemoteNotifications": true,
          "sounds": [
            "./assets/sounds/mga_bell.wav",
            "./assets/sounds/mga_chime.wav",
            "./assets/sounds/mga_alert.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "27a8000f-3bdf-41ac-a0d4-fa35239ea394"
      },
      "apiUrl": "",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
