# Copy this file to the Cloudways staging application .env.
# Never commit the filled file. Generate APP_KEY on the server with:
# php artisan key:generate

APP_NAME="MGA System Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://mgastaging.medguarda.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

SITE_PASSWORD=
SANCTUM_TOKEN_EXPIRATION=43200

STRIPE_KEY=
STRIPE_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_IMPERSONATE=
GOOGLE_CALENDAR_CREDENTIALS=
