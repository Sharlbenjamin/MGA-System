APP_NAME="MGA System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional second mailbox for invoices and financial mail
FINANCIAL_MAIL_MAILER=smtp
FINANCIAL_MAIL_HOST=
FINANCIAL_MAIL_PORT=587
FINANCIAL_MAIL_USERNAME=
FINANCIAL_MAIL_PASSWORD=
FINANCIAL_MAIL_ENCRYPTION=tls
FINANCIAL_MAIL_FROM_ADDRESS=
FINANCIAL_MAIL_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Filament site-password gate (web UI only; leave empty to disable locally)
SITE_PASSWORD=

# Sanctum personal-access tokens. Empty = tokens do not expire.
# Production recommendation: 43200 (30 days).
SANCTUM_TOKEN_EXPIRATION=

# Optional local seeder overrides. Never commit real passwords.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password
SEED_ADMIN_SMTP_USERNAME=
SEED_ADMIN_SMTP_PASSWORD=

# Third-party integrations (leave empty unless the feature is in use)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_IMPERSONATE=
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=
DISTANCE_API_ENABLED=false

WHATSAPP_ENABLED=true
WHATSAPP_DEFAULT_COUNTRY_CODE=353
COMMUNICATIONS_EMAIL_ENABLED=false

# HR employment contract drafts (optional overrides; form prefills these defaults)
HR_EMPLOYER_LEGAL_NAME="The Mid Gard for Project Management"
HR_EMPLOYER_ADDRESS=
HR_EMPLOYER_REGISTRATION=
HR_SIGNATORY_NAME=
HR_SIGNATORY_TITLE=CEO
HR_SALARY_CURRENCY=EGP
HR_LOGO_PATH=siglogo.png
